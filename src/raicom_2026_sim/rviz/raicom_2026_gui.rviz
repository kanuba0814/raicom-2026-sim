Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Occupancy Grid (SIM_ONLY)1
        - /LaserScan (fuse_scan)1
        - /Localization (SIM_ONLY when active)1
        - /Navigation (SIM_ONLY when active)1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded: []
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
      Value: true
    - Alpha: 0.75
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Occupancy Grid (SIM_ONLY)
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /raicom/red_blue_field_texture
      Name: Gazebo Field Reference (SIM_ONLY)
      Namespaces:
        sim_only_red_blue_field_texture: true
      Queue Size: 10
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 1
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/LaserScan
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: LaserScan (fuse_scan)
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (m): 0.02
      Style: Points
      Topic: /fuse_scan
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Tree: false
      Name: Robot Model
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.25
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: RGB
          Frame: Local
          Offset: 0.002
          Scale: 0.1
          Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 0.1
          Value: true
        Value: true
      Enabled: true
      Keep: 10
      Name: Odometry
      Position Tolerance: 0.1
      Queue Size: 10
      Shape:
        Alpha: 1
        Axes Length: 0.35
        Axes Radius: 0.03
        Color: 255; 85; 0
        Head Length: 0.1
        Head Radius: 0.06
        Shaft Length: 0.25
        Shaft Radius: 0.025
        Value: Arrow
      Topic: /odom
      Unreliable: false
      Value: true
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Class: rviz/PoseWithCovariance
          Enabled: true
          Name: AMCL Pose
          Shape:
            Alpha: 1
            Axes Length: 0.3
            Axes Radius: 0.02
            Color: 255; 25; 0
            Head Length: 0.1
            Head Radius: 0.06
            Shaft Length: 0.25
            Shaft Radius: 0.025
            Value: Arrow
          Topic: /amcl_pose
          Unreliable: false
          Value: true
        - Alpha: 1
          Arrow Length: 0.2
          Axes Length: 0.3
          Axes Radius: 0.01
          Class: rviz/PoseArray
          Color: 0; 192; 0
          Enabled: false
          Head Length: 0.07
          Head Radius: 0.03
          Name: AMCL Particle Cloud
          Queue Size: 10
          Shaft Length: 0.23
          Shaft Radius: 0.01
          Shape: Arrow (Flat)
          Topic: /particlecloud
          Unreliable: false
          Value: false
      Enabled: true
      Name: Localization (SIM_ONLY when active)
    - Class: rviz/Group
      Displays:
        - Alpha: 0.55
          Class: rviz/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: false
          Name: Global Costmap (SIM_ONLY when navigation active)
          Topic: /move_base/global_costmap/costmap
          Unreliable: false
          Use Timestamp: false
          Value: true
        - Alpha: 0.55
          Class: rviz/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: false
          Name: Local Costmap (SIM_ONLY when navigation active)
          Topic: /move_base/local_costmap/costmap
          Unreliable: false
          Use Timestamp: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 0; 0
          Enabled: false
          Head Diameter: 0.15
          Head Length: 0.1
          Length: 0.15
          Line Style: Lines
          Line Width: 0.03
          Name: Global Plan
          Pose Color: 255; 85; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.03
          Shaft Diameter: 0.05
          Shaft Length: 0.1
          Topic: /move_base/NavfnROS/plan
          Unreliable: false
          Value: false
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 80; 255
          Enabled: false
          Head Diameter: 0.15
          Head Length: 0.1
          Length: 0.15
          Line Style: Lines
          Line Width: 0.03
          Name: Local Plan
          Pose Color: 255; 85; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.03
          Shaft Diameter: 0.05
          Shaft Length: 0.1
          Topic: /move_base/DWAPlannerROS/local_plan
          Unreliable: false
          Value: false
        - Alpha: 1
          Axes Length: 0.35
          Axes Radius: 0.03
          Class: rviz/Pose
          Color: 255; 25; 0
          Enabled: false
          Head Length: 0.1
          Head Radius: 0.06
          Name: Move Base Goal
          Queue Size: 10
          Shaft Length: 0.25
          Shaft Radius: 0.025
          Shape: Arrow
          Topic: /move_base/current_goal
          Unreliable: false
          Value: false
      Enabled: false
      Name: Navigation (SIM_ONLY when active)
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/SetInitialPose
      Topic: /initialpose
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 6.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 0.5
        Swap Stereo Rendering: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.2
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.0
      Target Frame: base_footprint
      Yaw: 0.8
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1440
  X: 120
  Y: 80
