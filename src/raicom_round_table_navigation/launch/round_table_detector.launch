<launch>
  <arg name="scan_topic" default="/fuse_scan"/>
  <arg name="config" default="$(find raicom_round_table_navigation)/config/round_table_detector.yaml"/>
  <node pkg="raicom_round_table_navigation" type="round_table_detector_node.py" name="round_table_detector" output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <param name="scan_topic" value="$(arg scan_topic)"/>
  </node>
</launch>
