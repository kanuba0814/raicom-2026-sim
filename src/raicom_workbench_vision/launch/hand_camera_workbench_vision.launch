<launch>
  <!-- All values are SIM_WORKING_ASSUMPTION until calibrated against the accepted scene. -->
  <arg name="camera_image" default="/hand_camera/image_raw"/>
  <arg name="camera_info" default="/hand_camera/camera_info"/>
  <arg name="output_frame" default="hand_cam_link"/>
  <arg name="marker_topic" default="/raicom/workbench/markers"/>
  <!-- Reinovo hand-camera convention; measure the printed black border before venue use. -->
  <arg name="marker_size_cm" default="3.0"/>
  <arg name="overlay_topic" default="/raicom/workbench/hand_camera_overlay"/>
  <arg name="payload_pick_config" default="$(find raicom_workbench_vision)/config/camera_payload_pick.yaml"/>

  <node pkg="ar_track_alvar" type="individualMarkersNoKinect" name="workbench_alvar_detector" output="screen">
    <param name="marker_size" value="$(arg marker_size_cm)"/>
    <param name="max_new_marker_error" value="0.08"/>
    <param name="max_track_error" value="0.2"/>
    <param name="output_frame" value="$(arg output_frame)"/>
    <remap from="camera_image" to="$(arg camera_image)"/>
    <remap from="camera_info" to="$(arg camera_info)"/>
    <remap from="ar_pose_marker" to="$(arg marker_topic)"/>
  </node>

  <!-- Camera-only detector is the sole /raicom/workbench/slots authority. -->
  <node pkg="raicom_workbench_vision" type="camera_workbench_slot_detector.py"
        name="camera_workbench_slot_detector" output="screen">
    <param name="image_topic" value="$(arg camera_image)"/>
    <param name="camera_info_topic" value="$(arg camera_info)"/>
    <param name="marker_topic" value="$(arg marker_topic)"/>
  </node>

  <!-- Optional slot/overlay SIM stack retains AR; payload pick itself is
       independent and included from its standalone no-AR launch. -->
  <include file="$(find raicom_workbench_vision)/launch/camera_payload_pick.launch">
    <arg name="camera_image" value="$(arg camera_image)"/>
    <arg name="camera_info" value="$(arg camera_info)"/>
    <arg name="payload_pick_config" value="$(arg payload_pick_config)"/>
  </include>

  <node pkg="raicom_workbench_vision" type="hand_camera_workbench_overlay.py"
        name="hand_camera_workbench_overlay" output="screen">
    <param name="image_topic" value="$(arg camera_image)"/>
    <param name="camera_info_topic" value="$(arg camera_info)"/>
    <param name="markers_topic" value="$(arg marker_topic)"/>
    <param name="slots_topic" value="/raicom/workbench/slots"/>
    <param name="output_topic" value="$(arg overlay_topic)"/>
  </node>
</launch>
